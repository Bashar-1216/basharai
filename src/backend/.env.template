# ── bashar.ai Backend Environment Variables ──────────────────
# Copy this file to .env and fill in the values.

# Application
APP_NAME="bashar.ai API"
APP_VERSION="0.1.0"
DEBUG=true

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+asyncpg://local_developer:local_secure_password@localhost:5432/bashar_db"

# Redis (Rate Limiting & Response Cache)
REDIS_URL="redis://localhost:6379/0"

# OpenAI API
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Internal Security (BFF ↔ FastAPI)
INTERNAL_API_KEY="dev-internal-key-change-me"

# Sentry Error Tracking (optional for local dev)
SENTRY_DSN=""
