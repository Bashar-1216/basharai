# ========================
# Dependencies
# ========================
node_modules/
.pnp
.pnp.js
.pnp.cjs

# ========================
# Next.js Build Output
# ========================
.next/
out/
build/
.vercel

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
.venv/
venv/
env/
ENV/

# ========================
# Environment Variables
# ========================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# ========================
# IDE & Editors
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# ========================
# OS Files
# ========================
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ========================
# Testing & Coverage
# ========================
coverage/
.coverage
.coverage.*
htmlcov/
.nyc_output
*.lcov
.pytest_cache/
.mypy_cache/

# ========================
# Logs & Debug
# ========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ========================
# Docker
# ========================
docker-compose.override.yml

# ========================
# Database
# ========================
*.sqlite3
*.db

# ========================
# Misc
# ========================
*.tsbuildinfo
next-env.d.ts
.turbo

# Temporary files
tmp/
temp/

# Secrets & Keys
*.pem
*.key
*.crt
*.p12

# AI/ML Model Files (large binaries)
*.bin
*.h5
*.onnx
*.pt
*.pth
models/
!models/.gitkeep

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints/
